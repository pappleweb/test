# --- Copie ce fichier en ".env" et remplis ce que tu as. Tout est optionnel. ---

# Scénario généré par Claude Haiku (recommandé, ~1 centime / short).
# Sans cette clé, l'outil bascule sur un résumé "extractif" 100% gratuit.
# Récupère une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Banque d'images GRATUITE (recommandé). Mets-en au moins une.
# Pexels  : https://www.pexels.com/api/  (gratuit)
# Pixabay : https://pixabay.com/api/docs/ (gratuit, utilisé en secours)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Images IA générées (option, qualité supérieure) ---
# IMAGE_PROVIDER=stock (défaut, banque gratuite) | flux | openrouter
IMAGE_PROVIDER=stock

# FLUX via fal.ai : clé sur https://fal.ai/dashboard/keys -> FAL_KEY.
# schnell ~0,003 $/image (~2 cts/short, le moins cher). Pour dev/pro : change FLUX_ENDPOINT.
FAL_KEY=
# FLUX_ENDPOINT=https://fal.run/fal-ai/flux/schnell   # ou .../fal-ai/flux/dev

# OpenRouter -> modèles Gemini image (clé sur https://openrouter.ai/keys).
# gemini-3.1-flash-image sort nativement en 9:16 (~0,07 $/image, ~0,5 $/short).
# Variante moins chère mais carrée : OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_API_KEY=
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# IMAGE_STYLE=vertical 9:16 photograph, natural warm lighting, vivid appetizing colors, sharp focus, high detail, professional, no text, no watermark

# --- Réglages par défaut (modifiables aussi en ligne de commande) ---
# L'URL de TON site, affichée dans l'appel à l'action final.
SITE_URL=https://mon-site.fr

# Voix off française Edge-TTS (gratuit). Autres ex : fr-FR-HenriNeural, fr-FR-VivienneMultilingualNeural
TTS_VOICE=fr-FR-DeniseNeural

# --- ElevenLabs (voix premium, offre gratuite ~10k caractères/mois) ---
# Si ELEVENLABS_API_KEY est renseignée, elle est utilisée par défaut (--tts auto).
# Clé : https://elevenlabs.io/  (compte gratuit -> Profile -> API key)
ELEVENLABS_API_KEY=
# Voix : mets simplement un nom -> charlotte, alice, matilda, lily, sarah
# (ou un ID brut copié depuis https://elevenlabs.io/app/voice-library).
ELEVENLABS_VOICE_ID=charlotte
ELEVENLABS_MODEL=eleven_multilingual_v2

# Modèle Claude (le moins cher = Haiku)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
